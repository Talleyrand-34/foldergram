{
  "name": "@foldergram/server",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "npm run build && tsx src/scripts/migrate.ts && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p ../plugins/ai-analysis/tsconfig.json && tsc -p ../plugins/instagram-sync/tsconfig.json && node ../plugins/instagram-sync/copy-python.mjs",
    "build:server": "tsc -p tsconfig.json",
    "build:plugins": "tsc -p ../plugins/ai-analysis/tsconfig.json && tsc -p ../plugins/instagram-sync/tsconfig.json && node ../plugins/instagram-sync/copy-python.mjs",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "start": "node dist/scripts/migrate.js && node dist/index.js",
    "rescan": "tsx src/scripts/rescan.ts",
    "test": "vitest run",
    "test:sqlite": "DB_DRIVER=sqlite vitest run",
    "test:pg": "DB_DRIVER=postgres vitest run",
    "test:pg:parity": "DB_DRIVER=postgres vitest run test/dialect-parity.test.ts",
    "test:migration-safety": "vitest run test/migration-safety.test.ts",
    "build:check": "tsc -p tsconfig.json --noEmit && tsc -p ../plugins/ai-analysis/tsconfig.json --noEmit && tsc -p ../plugins/instagram-sync/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "chokidar": "^4.0.3",
    "dbmate": "^2.38.1",
    "dotenv": "^18.0.10",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
