# Runtime
NODE_ENV=development

# Ports
SERVER_PORT=4141 # Production only
DEV_SERVER_PORT=4140
DEV_CLIENT_PORT=4141

# Storage paths
DATA_ROOT=./data
GALLERY_ROOT=./data/gallery
DB_DIR=./data/db
THUMBNAILS_DIR=./data/thumbnails
PREVIEWS_DIR=./data/previews

# Optional: comma-separated folder rules by name or exact relative path, for example @eaDir,thumbnails,Archive/cache
GALLERY_EXCLUDED_FOLDERS=

# Media behavior
# Controls what the image detail page loads: 'preview' (default) or 'original'
IMAGE_DETAIL_SOURCE=preview
# Controls when thumbnails/previews are generated: 'eager' (default, at scan time) or 'lazy' (on first request)
DERIVATIVE_MODE=eager

# Scan and logging
LOG_VERBOSE=0
# Controls scan-time supported-media failures: 'skip' (default, report and continue) or 'fail' (stop on first error)
SCAN_MEDIA_ERROR_MODE=skip
SCAN_DISCOVERY_CONCURRENCY=4
SCAN_DERIVATIVE_CONCURRENCY=4

# Remote transcoder
# Sends the heavy ffmpeg work to another host that has a GPU. See
# services/transcoder/README.md for the agent and docs/media-processing.md
# for what this changes.
# 'local' (default) keeps everything on this host, 'remote' always uses the
# agent, 'auto' uses it when a URL is configured.
# FFMPEG_TRANSCODER_MODE=remote
# FFMPEG_TRANSCODER_URL=http://10.0.2.31:8787
# FFMPEG_TRANSCODER_TOKEN=
# The derivative kinds that may leave the host: 'video-preview' (default),
# a comma-separated list, or '*' for all of them.
# FFMPEG_TRANSCODER_OPERATIONS=video-preview
# 'auto' lets the agent pick the encoder its hardware supports, 'vaapi' and
# 'software' force one.
# FFMPEG_TRANSCODER_ENCODER=auto
# A failed remote job is retried locally unless this is 'off'.
# FFMPEG_TRANSCODER_FALLBACK=local
# Sources larger than this stay on this host.
# FFMPEG_TRANSCODER_MAX_UPLOAD_BYTES=536870912

# Database driver
# Use 'sqlite' (default) for embedded storage or 'postgres' for a PostgreSQL database.
DB_DRIVER=sqlite
# Required when DB_DRIVER=postgres. Example: postgresql://user:password@localhost:5432/foldergram
# DATABASE_URL=postgresql://user:password@localhost:5432/foldergram?sslmode=disable

# Access control
PUBLIC_DEMO_MODE=0
CSRF_TRUSTED_ORIGINS=

# Telemetry (OpenTelemetry)
# Off unless one of these is set. The metrics and traces leave the app through
# an OTLP endpoint, so they can be read by an OpenTelemetry Collector,
# Prometheus or Grafana instead of a chart inside the app.
# TELEMETRY_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=foldergram
# OTEL_RESOURCE_ATTRIBUTES=env=production
# How often the metrics are pushed, in milliseconds.
# OTEL_METRIC_EXPORT_INTERVAL=15000

# Profiling (Pyroscope)
# Off unless PYROSCOPE_SERVER_ADDRESS is set. The profiles of the Node.js
# process are pushed to that Pyroscope, which Grafana reads to draw the flame
# graphs.
# PYROSCOPE_SERVER_ADDRESS=http://localhost:4040
# PYROSCOPE_APPLICATION_NAME=foldergram
# How often the profiles are pushed, in milliseconds.
# PYROSCOPE_FLUSH_INTERVAL_MS=60000
# How often the stack is sampled, in microseconds.
# PYROSCOPE_WALL_SAMPLING_INTERVAL_MICROS=10000
# The allocation profile is expensive, so it is opt in.
# PYROSCOPE_HEAP_PROFILING=0
